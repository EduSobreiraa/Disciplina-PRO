NODE_ENV=development
DEPLOYMENT_STAGE=local
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY_HOPS=0
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
OTEL_SERVICE_NAME=disciplina-pro-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

POSTGRES_DB=disciplina_pro
POSTGRES_USER=disciplina_pro
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://disciplina_pro:change_me@localhost:5432/disciplina_pro
DATABASE_POOL_MAX=5
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=disciplina-pro-api
JWT_ACTIVE_KID=local-ephemeral
REFRESH_TOKEN_PEPPER=development-only-refresh-pepper-change-me
INVITATION_TOKEN_PEPPER=development-only-invitation-pepper-change-me
INVITATION_ACCEPTANCE_URL=http://localhost:5173/convites/aceitar
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_DELIVERY_ENABLED=true
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=
SMTP_FROM=Disciplina PRO <no-reply@disciplina.local>
SWAGGER_ENABLED=true
OUTBOX_WORKER_POLL_INTERVAL_MS=1000
OUTBOX_WORKER_ERROR_DELAY_MS=5000

# Apenas laboratório: exige LAB_SEED_CONFIRM=seed-disciplina-pro-lab e um banco descartável.
LAB_SEED_ADMIN_EMAIL=lab-superadmin@disciplina.test
LAB_SEED_CEO_EMAIL=lab-ceo@disciplina.test
LAB_SEED_MANAGER_EMAIL=lab-manager@disciplina.test
LAB_SEED_USER_EMAIL=lab-user@disciplina.test
LAB_SEED_PASSWORD=
LAB_SEED_TENANT_SLUG=organizacao-laboratorio
LAB_SEED_CONFIRM=
# Exigida adicionalmente apenas para o banco padrão /railway da conta técnica temporária.
LAB_SEED_ALLOW_DEFAULT_RAILWAY_DATABASE=
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
