generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TenantRole {
  USER
  MANAGER
  CEO
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PlatformRole {
  SUPER_ADMIN
}

enum PlatformAccessStatus {
  ACTIVE
  SUSPENDED
}

enum AuditActorType {
  MEMBERSHIP
  PLATFORM_ACCESS
  SYSTEM
}

model User {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String             @db.VarChar(320)
  normalizedEmail String             @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String             @map("password_hash") @db.Text
  status          UserStatus         @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt      DateTime?          @map("disabled_at") @db.Timestamptz(3)
  memberships     TenantMembership[]
  platformAccess  PlatformAccess?
  sessions        AuthSession[]

  @@map("users")
}

model Tenant {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String             @db.VarChar(160)
  slug        String             @unique @db.VarChar(80)
  timeZone    String             @default("America/Bahia") @map("time_zone") @db.VarChar(100)
  status      TenantStatus       @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt DateTime?          @map("suspended_at") @db.Timestamptz(3)
  closedAt    DateTime?          @map("closed_at") @db.Timestamptz(3)
  memberships TenantMembership[]
  auditEvents AuditEvent[]

  @@map("tenants")
}

model TenantMembership {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  role          TenantRole       @default(USER)
  status        MembershipStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt   DateTime?        @map("suspended_at") @db.Timestamptz(3)
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  actorEvents   AuditEvent[]     @relation("AuditActorMembership")
  targetEvents  AuditEvent[]     @relation("AuditTargetMembership")

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status, role])
  @@map("tenant_memberships")
}

model PlatformAccess {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String               @unique @map("user_id") @db.Uuid
  role              PlatformRole         @default(SUPER_ADMIN)
  status            PlatformAccessStatus @default(ACTIVE)
  grantedAt         DateTime             @default(now()) @map("granted_at") @db.Timestamptz(3)
  suspendedAt       DateTime?            @map("suspended_at") @db.Timestamptz(3)
  grantedByAccessId String?              @map("granted_by_access_id") @db.Uuid
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  grantedBy         PlatformAccess?      @relation("PlatformAccessGrants", fields: [grantedByAccessId], references: [id], onDelete: Restrict)
  grants            PlatformAccess[]     @relation("PlatformAccessGrants")
  actorEvents       AuditEvent[]         @relation("AuditActorPlatformAccess")

  @@index([status])
  @@map("platform_accesses")
}

model AuthSession {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  familyId          String         @unique @default(dbgenerated("uuidv7()")) @map("family_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime       @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?        @map("revocation_reason") @db.VarChar(120)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId         String        @map("session_id") @db.Uuid
  tokenHash         String        @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt        DateTime?     @map("consumed_at") @db.Timestamptz(3)
  revokedAt         DateTime?     @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?       @unique @map("replaced_by_token_id") @db.Uuid
  session           AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replaces          RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditEvent {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String?           @map("tenant_id") @db.Uuid
  actorType             AuditActorType    @map("actor_type")
  actorMembershipId     String?           @map("actor_membership_id") @db.Uuid
  actorPlatformAccessId String?           @map("actor_platform_access_id") @db.Uuid
  targetMembershipId    String?           @map("target_membership_id") @db.Uuid
  entityType            String            @map("entity_type") @db.VarChar(80)
  entityId              String?           @map("entity_id") @db.Uuid
  action                String            @db.VarChar(120)
  metadata              Json              @default("{}") @db.JsonB
  occurredAt            DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant                Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorMembership       TenantMembership? @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: Restrict)
  actorPlatformAccess   PlatformAccess?   @relation("AuditActorPlatformAccess", fields: [actorPlatformAccessId], references: [id], onDelete: Restrict)
  targetMembership      TenantMembership? @relation("AuditTargetMembership", fields: [targetMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([actorMembershipId, occurredAt])
  @@index([actorPlatformAccessId, occurredAt])
  @@map("audit_events")
}
