{
  "name": "disciplina-pro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "docs:check": "node scripts/check-docs.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:operations",
    "test:operations": "node ops/backup/backup-restore-scripts.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e:backend && npm run test:e2e:frontend",
    "test:e2e:backend": "npm run test:e2e --workspace backend",
    "test:e2e:external": "npm run test:e2e:external --workspace frontend",
    "test:e2e:frontend": "npm run test:e2e --workspace frontend",
    "test:integration": "npm run test:integration --workspace backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:validate": "npm run prisma:validate --workspace backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace backend",
    "prisma:migrate:status": "npm run prisma:migrate:status --workspace backend",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "argon2@0.44.0": true,
    "prisma@7.9.1": true,
    "@scarf/scarf": false
  },
  "overrides": {
    "browserslist": "4.28.8",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "fast-uri": "3.1.4",
    "prisma": {
      "mysql2": "3.22.0"
    },
    "postcss": "8.5.23",
    "qs": "6.16.0"
  }
}
